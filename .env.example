# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- TrackStreet login ---
TRACKSTREET_URL=https://platform.trackstreet.com
TRACKSTREET_EMAIL=you@example.com
TRACKSTREET_PASSWORD=

# --- Working folders ---
BASE_DIR=C:\TrackStreetSync
# Output location must match what Tableau's data source points to.
OUTPUT_DIR=C:\TrackStreetSync\Output
OUTPUT_FILENAME=trackstreet_combined.csv
# DOWNLOAD_DIR=C:\TrackStreetSync\exports

# --- Browser --- true if you want to watch the script run, false to run in background
HEADLESS=true
# Uncomment to drive an already-installed Edge instead of Playwright's own
# Chromium download (useful if the proxy blocks Playwright's browser
# download -- see README "Proxy / browser download issues"):
# BROWSER_CHANNEL=msedge

# true = stop after export, let Power Query handle combine/clean (temporary
# workaround until Tableau access is sorted). false = run full pipeline.
# SKIP_COMBINE=true

# --- Retry behavior ---
NAV_TIMEOUT_MS=30000
MAX_RETRIES=2
RETRY_DELAY_SEC=10

# --- Email alerts (leave SMTP_HOST blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_FROM=trackstreet-sync@yourcompany.com
ALERT_TO=you@yourcompany.com

# --- Two-factor verification via Gmail (leave blank to disable) ---
# Dedicated Gmail inbox TrackStreet sends its verification codes to.
GMAIL_ADDRESS=
# Google App Password (16 letters) from https://myaccount.google.com/apppasswords
# -- NOT the normal Gmail password. Requires 2-Step Verification on the account.
GMAIL_APP_PASSWORD=
# VERIFY_MAX_ATTEMPTS=3
# VERIFY_EMAIL_WAIT_SEC=120
